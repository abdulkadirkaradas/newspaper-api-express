# ============================================
# Project-Wide Environment Variables (Infrastructure)
# ============================================

# Application
APP_NAME="Newspaper App"
NODE_ENV=development

# Database configuration (Shared between Docker and API)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Common network settings
API_PORT=3000
WEB_PORT=3001
POSTGRES_PORT=5432
