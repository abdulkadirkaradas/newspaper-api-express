// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
  type String @unique
  User User[] @relation("UserRole")
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  lastname             String?
  username             String         @unique
  email                String         @unique
  emailVerifiedAt      DateTime?
  password             String
  blocked              Boolean        @default(false)
  roleId               Int
  role                 Role           @relation("UserRole", fields: [roleId], references: [id])
  deleted              Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  notifications        Notification[] @relation("UserNotification")
  warnings             Warning[]      @relation("UserWarning")
  news                 News[]         @relation("UserNews")
  newsImages           NewsImage[]    @relation("UserNewsImage")
  newsReactions        NewsReaction[] @relation("UserNewsReaction")
  oppositeNewsSource   OppositeNews[] @relation("SourceUser")
  oppositeNewsOpposite OppositeNews[] @relation("OppositeUser")
  userBadges           UserBadges[]   @relation("UserBadges")
}

model Notification {
  id        String   @id @default(cuid())
  type      String?
  title     String
  content   String
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation("UserNotification", fields: [userId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warning {
  id           String   @id @default(cuid())
  content      String
  reason       String
  warningLevel Int
  userId       String
  user         User     @relation("UserWarning", fields: [userId], references: [id])
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Badge {
  id          String       @id @default(cuid())
  name        String
  description String
  type        String
  ext         String
  fullpath    String
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userBadges  UserBadges[] @relation("Badge")
}

model NewsCategory {
  id          String   @id @default(cuid())
  name        String
  description String
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  news        News[]   @relation("NewsCategory")
}

model News {
  id                   String         @unique @default(cuid())
  title                String
  content              String
  priority             Int            @default(3)
  pinned               Boolean        @default(false)
  visibility           Boolean        @default(true)
  opposition           Boolean        @default(false)
  approvedBy           String         @default("")
  removedBy            String         @default("")
  userId               String
  categoryId           String
  user                 User           @relation("UserNews", fields: [userId], references: [id])
  category             NewsCategory   @relation("NewsCategory", fields: [categoryId], references: [id])
  deleted              Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  images               NewsImage[]    @relation("NewsImage")
  reactions            NewsReaction[] @relation("NewsReaction")
  oppositeNewsSource   OppositeNews[] @relation("SourceNews")
  oppositeNewsOpposite OppositeNews[] @relation("OppositeNews")
}

model NewsImage {
  id        String   @id @default(cuid())
  name      String
  ext       String
  fullpath  String
  userId    String
  newsId    String
  user      User     @relation("UserNewsImage", fields: [userId], references: [id])
  news      News     @relation("NewsImage", fields: [newsId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsReaction {
  id        String   @unique @default(cuid())
  reaction  String
  type      String
  userId    String
  newsId    String
  user      User     @relation("UserNewsReaction", fields: [userId], references: [id])
  news      News     @relation("NewsReaction", fields: [newsId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OppositeNews {
  id             String   @id @default(cuid())
  sourceUserId   String
  oppositeUserId String
  sourceNewsId   String
  oppositeNewsId String
  sourceUser     User     @relation("SourceUser", fields: [sourceUserId], references: [id])
  oppositeUser   User     @relation("OppositeUser", fields: [oppositeUserId], references: [id])
  sourceNews     News     @relation("SourceNews", fields: [sourceNewsId], references: [id])
  oppositeNews   News     @relation("OppositeNews", fields: [oppositeNewsId], references: [id])
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserBadges {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation("UserBadges", fields: [userId], references: [id])
  badge     Badge    @relation("Badge", fields: [badgeId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  Int
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}