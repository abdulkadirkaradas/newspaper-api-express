// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique
  type String @unique
  User User[] @relation("UserRole")
}

model User {
  id              String         @id @default(cuid())
  name            String?
  lastname        String?
  username        String         @unique
  email           String         @unique
  emailVerifiedAt DateTime?      @db.Timestamptz(3)
  password        String
  blocked         Boolean        @default(false)
  roleId          Int
  role            Role           @relation("UserRole", fields: [roleId], references: [id])
  deleted         Boolean        @default(false)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  notifications   Notification[] @relation("UserNotification")
  warnings        Warning[]      @relation("UserWarning")
  posts           Post[]         @relation("UserPost")
  postReactions   PostReaction[] @relation("UserPostReaction")
  userBadges      UserBadges[]   @relation("UserBadges")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  Int      @default(3)
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation("UserNotification", fields: [userId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Warning {
  id           String   @id @default(cuid())
  content      String
  reason       String
  warningLevel Int
  userId       String
  user         User     @relation("UserWarning", fields: [userId], references: [id])
  deleted      Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Badge {
  id          String       @id @default(cuid())
  name        String
  description String
  type        String
  mimeType    String
  fullpath    String
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  userBadges  UserBadges[] @relation("Badge")
}

model PostCategory {
  id          String   @id @default(cuid())
  name        String
  description String
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  posts       Post[]   @relation("PostCategory")
}

model Post {
  id           String         @id @default(cuid())
  title        String
  content      String         @db.Text
  pinned       Boolean        @default(false)
  visibility   Boolean        @default(false)
  approvedBy   String         @default("")
  removedBy    String         @default("")
  opposedToId  String?
  opposedTo    Post?          @relation("PostDebate", fields: [opposedToId], references: [id])
  counterPosts Post[]         @relation("PostDebate")
  authorId     String
  author       User           @relation("UserPost", fields: [authorId], references: [id])
  categoryId   String?
  category     PostCategory?  @relation("PostCategory", fields: [categoryId], references: [id])
  upvotes      Int            @default(0)
  downvotes    Int            @default(0)
  score        Int            @default(0)
  deleted      Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  images       PostImage[]    @relation("PostImage")
  reactions    PostReaction[] @relation("PostReaction")

  @@index([opposedToId])
}

model PostImage {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  fullpath  String
  postId    String
  post      Post     @relation("PostImage", fields: [postId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model PostReaction {
  id        String   @id @default(cuid())
  value     Int
  authorId  String
  postId    String
  author    User     @relation("UserPostReaction", fields: [authorId], references: [id])
  post      Post     @relation("PostReaction", fields: [postId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([postId, authorId])
  @@index([postId])
}

model UserBadges {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation("UserBadges", fields: [userId], references: [id])
  badge     Badge    @relation("Badge", fields: [badgeId], references: [id])
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  Int
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
